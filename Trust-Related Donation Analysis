# Data preparation

```{r data-preparation, message=FALSE, warning=FALSE}
library(dplyr)
library(tidyr)
library(lme4)
library(lmerTest)
library(emmeans)

as_numeric <- function(x) as.numeric(as.character(x))
mean_or_na <- function(x) {
  x <- as_numeric(x)
  if (all(is.na(x))) NA_real_ else mean(x, na.rm = TRUE)
}
z_score <- function(x) as.numeric(scale(as_numeric(x)))
first_look <- function(latencies) {
  if (all(is.na(latencies))) return(NA_character_)
  first_region <- which(latencies == min(latencies, na.rm = TRUE))
  if (length(first_region) != 1) return("tie")
  c("Eye", "Glabella", "Nose", "Mouth")[first_region]
}

prime_levels <- c("neutral", "approach", "avoid")
region_levels <- c("Eye", "Glabella", "Nose", "Mouth")
glmer_control <- glmerControl(optimizer = "bobyqa", optCtrl = list(maxfun = 100000))
lmer_control <- lmerControl(optimizer = "bobyqa", optCtrl = list(maxfun = 100000))

df_raw <- read.csv("data/trials_clean.csv", check.names = FALSE) %>%
  transmute(
    Subject = factor(participant_id), Trial = trial_number,
    prime = factor(prime, levels = prime_levels), affect, face = stimulus_id,
    Donate = as_numeric(donation), valence, arousal,
    totalFixDur_Eyes, totalFixDur_eyebrow, totalFixDur_nose, totalFixDur_mouth,
    fixLatency_Eyes, fixLatency_eyebrow, fixLatency_nose, fixLatency_mouth,
    pupil_dilation, DOSPERT, Cooperative, attractiveness, mtrust
  )

df <- df_raw %>%
  group_by(Subject, prime, affect, face) %>%
  summarise(
    Donate = first(Donate), valence = first(valence), arousal = first(arousal),
    totalFixDur_Eye = mean_or_na(totalFixDur_Eyes) / 1000,
    totalFixDur_Glabella = mean_or_na(totalFixDur_eyebrow) / 1000,
    totalFixDur_Nose = mean_or_na(totalFixDur_nose) / 1000,
    totalFixDur_Mouth = mean_or_na(totalFixDur_mouth) / 1000,
    fixLatency_Eye = mean_or_na(fixLatency_Eyes) / 1000,
    fixLatency_Glabella = mean_or_na(fixLatency_eyebrow) / 1000,
    fixLatency_Nose = mean_or_na(fixLatency_nose) / 1000,
    fixLatency_Mouth = mean_or_na(fixLatency_mouth) / 1000,
    pupil = mean_or_na(pupil_dilation), DOSPERT = first(DOSPERT),
    Cooperative = first(Cooperative), attractiveness = first(attractiveness),
    mtrust = first(mtrust), .groups = "drop"
  ) %>%
  mutate(
    arousal_mc = arousal - mean(arousal, na.rm = TRUE),
    z_DOSPERT = z_score(DOSPERT), z_Cooperative = z_score(Cooperative),
    z_attractiveness = z_score(attractiveness), z_mtrust = z_score(mtrust),
    total_aoi_fixdur = totalFixDur_Eye + totalFixDur_Glabella +
      totalFixDur_Nose + totalFixDur_Mouth,
    prop_Eye = if_else(total_aoi_fixdur > 0, totalFixDur_Eye / total_aoi_fixdur, NA_real_),
    prop_Glabella = if_else(total_aoi_fixdur > 0, totalFixDur_Glabella / total_aoi_fixdur, NA_real_),
    prop_Nose = if_else(total_aoi_fixdur > 0, totalFixDur_Nose / total_aoi_fixdur, NA_real_),
    prop_Mouth = if_else(total_aoi_fixdur > 0, totalFixDur_Mouth / total_aoi_fixdur, NA_real_)
  )

latencies <- as.matrix(df[, c(
  "fixLatency_Eye", "fixLatency_Glabella", "fixLatency_Nose", "fixLatency_Mouth"
)])
storage.mode(latencies) <- "numeric"
latencies[!is.finite(latencies)] <- NA_real_

df <- df %>%
  mutate(
    firstLook_AOI = factor(apply(latencies, 1, first_look), levels = c(region_levels, "tie")),
    firstLook_Eye = as.integer(firstLook_AOI == "Eye"),
    firstLook_Glabella = as.integer(firstLook_AOI == "Glabella"),
    firstLook_Nose = as.integer(firstLook_AOI == "Nose"),
    firstLook_Mouth = as.integer(firstLook_AOI == "Mouth")
  )

analysis_complete <- function(data, outcome) {
  data %>%
    filter(
      !is.na(.data[[outcome]]), !is.na(valence), !is.na(arousal_mc), !is.na(prime),
      !is.na(z_DOSPERT), !is.na(z_Cooperative), !is.na(z_attractiveness), !is.na(z_mtrust)
    )
}

donation_dat <- analysis_complete(df, "Donate")
firstlook_dat <- analysis_complete(df %>% filter(firstLook_AOI %in% region_levels), "Donate")
pupil_dat <- analysis_complete(df, "pupil")

reference_at <- list(valence = 0, arousal_mc = 0)

context_comparisons <- function(model) {
  condition <- as.data.frame(
    pairs(emmeans(model, ~ prime, at = reference_at), adjust = "none")
  ) %>% mutate(comparison_type = "Condition difference")

  valence <- as.data.frame(
    pairs(emtrends(model, ~ prime, var = "valence", at = reference_at), adjust = "none")
  ) %>% mutate(comparison_type = "Valence association difference")

  arousal <- as.data.frame(
    pairs(emtrends(model, ~ prime, var = "arousal_mc", at = reference_at), adjust = "none")
  ) %>% mutate(comparison_type = "Arousal association difference")

  results <- bind_rows(condition, valence, arousal)
  approach_avoid <- results$contrast == "approach - avoid"
  results$p_holm_approach_avoid <- NA_real_
  results$p_holm_approach_avoid[approach_avoid] <- p.adjust(
    results$p.value[approach_avoid], method = "holm"
  )
  results
}

fit_lmer_models <- function(outcome, data) {
  primary <- lmer(
    as.formula(paste0(
      outcome,
      " ~ valence * prime + arousal_mc * prime + z_DOSPERT + z_Cooperative + ",
      "z_attractiveness + z_mtrust + (1 | Subject)"
    )),
    data = analysis_complete(data, outcome), REML = TRUE, control = lmer_control
  )
  valence_arousal <- update(primary, . ~ . + valence:arousal_mc)
  three_way <- update(valence_arousal, . ~ . + valence:arousal_mc:prime)

  list(
    primary = primary,
    valence_arousal = valence_arousal,
    three_way = three_way,
    valence_arousal_lrt = anova(update(primary, REML = FALSE), update(valence_arousal, REML = FALSE)),
    three_way_lrt = anova(update(valence_arousal, REML = FALSE), update(three_way, REML = FALSE)),
    context_comparisons = context_comparisons(primary)
  )
}

fit_glmer_models <- function(outcome, data, random_effect = "(1 | Subject)") {
  primary <- glmer(
    as.formula(paste0(
      outcome,
      " ~ valence * prime + arousal_mc * prime + z_DOSPERT + z_Cooperative + ",
      "z_attractiveness + z_mtrust + ", random_effect
    )),
    data = analysis_complete(data, outcome), family = binomial, control = glmer_control
  )
  valence_arousal <- update(primary, . ~ . + valence:arousal_mc)
  three_way <- update(valence_arousal, . ~ . + valence:arousal_mc:prime)

  list(
    primary = primary,
    valence_arousal = valence_arousal,
    three_way = three_way,
    valence_arousal_lrt = anova(primary, valence_arousal, test = "Chisq"),
    three_way_lrt = anova(valence_arousal, three_way, test = "Chisq"),
    context_comparisons = context_comparisons(primary)
  )
}
```

# RQ1 and H1: Donation decisions

```{r rq1-donation}
m_donation <- fit_glmer_models("Donate", donation_dat, random_effect = "(prime | Subject)")

summary(m_donation$primary)
summary(m_donation$valence_arousal)
m_donation$valence_arousal_lrt
m_donation$three_way_lrt
m_donation$context_comparisons
