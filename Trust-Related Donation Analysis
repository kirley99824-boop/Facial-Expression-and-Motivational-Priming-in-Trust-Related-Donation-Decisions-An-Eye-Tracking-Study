# RQ4: Regional gaze allocation and donation decisions

```{r rq4-regional-gaze-donation}
# Regional fixation proportion
df_region <- df %>%
  mutate(trial_id = row_number()) %>%
  select(trial_id, Subject, Donate, z_DOSPERT, z_Cooperative, z_attractiveness,
    z_mtrust, prop_Eye, prop_Glabella, prop_Nose, prop_Mouth) %>%
  pivot_longer(starts_with("prop_"), names_to = "region", names_prefix = "prop_",
    values_to = "proportion") %>%
  filter(!is.na(Donate), !is.na(proportion), !is.na(z_DOSPERT), !is.na(z_Cooperative),
    !is.na(z_attractiveness), !is.na(z_mtrust)) %>%
  mutate(region = factor(region, levels = c("Eye", "Glabella", "Mouth", "Nose")),
    z_proportion = z_score(proportion))

contrasts(df_region$region) <- contr.sum(4)
colnames(contrasts(df_region$region)) <- c("Eye_vs_mean", "Glabella_vs_mean", "Mouth_vs_mean")

m_region_intercept <- glmer(
  Donate ~ region + z_DOSPERT + z_Cooperative + z_attractiveness + z_mtrust + (1 | Subject),
  data = df_region, family = binomial, control = glmer_control
)

m_region_common_slope <- update(m_region_intercept, . ~ . + z_proportion)
m_region_donation <- update(m_region_common_slope, . ~ . + region:z_proportion)

summary(m_region_donation)
m_region_common_slope_lrt <- anova(m_region_intercept, m_region_common_slope, test = "Chisq")
m_region_slope_lrt <- anova(m_region_common_slope, m_region_donation, test = "Chisq")
m_region_common_slope_lrt
m_region_slope_lrt

# First-look location
firstlook_donation <- df %>%
  filter(firstLook_AOI %in% region_levels, !is.na(Donate)) %>%
  mutate(firstLook_AOI = droplevels(firstLook_AOI))

firstlook_chisq <- chisq.test(
  table(firstLook_AOI = firstlook_donation$firstLook_AOI, Donate = firstlook_donation$Donate),
  correct = FALSE
)
firstlook_chisq

firstlook_pairwise <- combn(region_levels, 2, simplify = FALSE) %>%
  lapply(function(regions) {
    subset_data <- firstlook_donation %>% filter(firstLook_AOI %in% regions)
    test <- chisq.test(
      table(firstLook_AOI = factor(subset_data$firstLook_AOI, levels = regions), Donate = subset_data$Donate),
      correct = FALSE
    )
    tibble(
      comparison = paste(regions, collapse = " vs. "),
      chisq = unname(test$statistic),
      df = unname(test$parameter),
      p = test$p.value
    )
  }) %>%
  bind_rows() %>%
  mutate(p_holm = p.adjust(p, method = "holm"))
firstlook_pairwise
```

